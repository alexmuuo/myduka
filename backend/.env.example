# ==================================================
# MYDUKA ENVIRONMENT CONFIGURATION
# Copy this file to backend/.env for local development.
# Never commit real credentials.
# ==================================================


# ==================================================
# SUPABASE
# ==================================================

# Supabase project URL
SUPABASE_URL=

# Supabase publishable key (or legacy anon key)
SUPABASE_ANON_KEY=

# Supabase PostgreSQL connection string
# Use Supavisor pooled connection (port 6543) for Vercel.
DATABASE_URL=


# ==================================================
# APPLICATION
# ==================================================

FLASK_DEBUG=false

# Local frontend during development.
# Add the production frontend URL when deploying.
CORS_ORIGINS=http://localhost:5173

FRONTEND_URL=http://localhost:5173


# ==================================================
# EMAIL CONFIGURATION
# ==================================================

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=


# ==================================================
# MPESA CONFIGURATION
# ==================================================

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
