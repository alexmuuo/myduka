# Copy to backend/.env for local development. In production set these in
# the Vercel project settings. Never commit real values.

# Supabase Postgres. Use the pooled (Supavisor, port 6543) connection string
# on Vercel. The new MyDuka database only, never any other project's.
DATABASE_URL=

# Long random strings, a different one for each.
ADMIN_TOKEN_SECRET=
CASHIER_TOKEN_SECRET=
CUSTOMER_TOKEN_SECRET=

# Temporary platform admin until the users table exists (hash via werkzeug).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Comma-separated extra origins for CORS. Same-origin /api needs none.
CORS_ORIGINS=http://localhost:5173

# Frontend base URL used in password-reset emails.
FRONTEND_URL=http://localhost:5173

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
